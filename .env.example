# Copiar para .env e preencher. Nunca commitar o .env real.

# --- Base de dados ---
DB_URL=jdbc:postgresql://host.docker.internal:5432/finance
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=finance
DB_PORT=5432

# --- JWT (gerar: openssl rand -base64 64) ---
JWT_SECRET=change-me-use-openssl-rand-base64-64
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Frontend / CORS (separar vários origins por vírgula) ---
FRONTEND_URL=https://app.exemplo.com
CORS_ALLOWED_ORIGINS=https://app.exemplo.com

# --- Cookies (true em HTTPS) ---
AUTH_COOKIE_SECURE=true

# --- Swagger (false em produção) ---
SWAGGER_ENABLED=false
JPA_SHOW_SQL=false

# --- SMTP (vazio = link de reset só no log do servidor) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Docker ports (opcional) ---
BACKEND_PORT=8081
FRONTEND_PORT=80
SERVER_PORT=8081
